@startuml usecase
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor LightCyan
    BorderColor DarkCyan
    ArrowColor Teal
}
skinparam actor {
    BackgroundColor AliceBlue
    BorderColor DarkBlue
}

actor "Administrateur" as Admin
actor "Utilisateur" as User

rectangle "Système de Clavardage Distribué" {
    
    ' Cas d'utilisation de l'Administrateur
    usecase "Déployer l'agent sur les postes" as UC_Deploy
    usecase "Gérer l'agent\n(ajouter des modules / retirer)" as UC_Manage
    
    ' Cas d'utilisation de l'Utilisateur
    usecase "Gérer son pseudonyme\n(choisir ou modifier)" as UC_Pseudo
    usecase "Vérifier l'unicité du pseudonyme" as UC_Unicite
    
    usecase "Consulter les utilisateurs actifs" as UC_ActiveUsers
    
    usecase "Gérer une session de clavardage\n(démarrer / terminer)" as UC_Session
    usecase "Échanger du contenu\n(textes, images, fichiers)" as UC_Exchange
    usecase "Consulter l'historique des messages" as UC_History
    
    usecase "Réduire l'agent (barre des tâches)" as UC_Minimize
}

' Relations d'inclusion et d'extension
UC_Pseudo ..> UC_Unicite : <<include>>
UC_Exchange ..> UC_Session : <<extend>>
UC_History ..> UC_Session : <<extend>>

' Connexions Administrateur
Admin --> UC_Deploy
Admin --> UC_Manage

' Connexions Utilisateur
User --> UC_Pseudo
User --> UC_ActiveUsers
User --> UC_Session
User --> UC_Exchange
User --> UC_Minimize

@enduml
